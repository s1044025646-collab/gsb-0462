{
  "name": "twelve-tone-chord-backend",
  "version": "1.0.0",
  "description": "十二音级集合严格模板匹配的和弦识别 / 低音转位解释后端（API + CLI）",
  "type": "module",
  "bin": {
    "chord-cli": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "start": "npm run build && node dist/src/server.js",
    "demo": "npm run build && node dist/src/cli.js demo"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
