{
  "name": "pitch-class-chord-backend",
  "version": "1.0.0",
  "description": "十二音级和弦结构识别与低音转位解释后端（仅 API 与 CLI）",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test \"dist/tests/**/*.test.js\"",
    "start": "node --experimental-sqlite dist/src/server.js",
    "dev": "node --experimental-sqlite --experimental-strip-types scripts/run-ts.ts src/server.ts",
    "demo": "npm run build && node --experimental-sqlite dist/scripts/demo.js",
    "cli": "node --experimental-sqlite dist/src/cli.js"
  },
  "bin": {
    "chord": "dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
